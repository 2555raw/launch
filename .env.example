# ──────────────────────────────────────────────────────────────────────────────
# Launch / Emberhold — environment configuration
# Copy to .env and adjust. `npm run setup` does this for you with safe dev defaults.
# Every value here is read by apps/api, apps/game-server and apps/web (NEXT_PUBLIC_*).
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launch_dev
# Used by `npm test` (integration tests run against a separate database)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/launch_test

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Services ─────────────────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
GAME_SERVER_PORT=4100
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (the setup script does this for dev)
JWT_SECRET=change-me-generate-a-64-hex-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# 32-byte hex key used to encrypt user-linked third-party credentials at rest
CREDENTIALS_ENCRYPTION_KEY=change-me-generate-a-64-hex-secret
# Optional: first admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Admin-123

# ── Solana ───────────────────────────────────────────────────────────────────
# mainnet-beta | devnet | testnet
# Production default is mainnet-beta. The public RPC is rate limited: use a dedicated RPC
# provider (Helius, Triton, QuickNode...) for real traffic. Devnet is used by `npm run test:devnet`.
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# Optional server-side keypair (JSON byte array, as produced by `solana-keygen`)
# Only used by the devnet test suite and admin tooling. Never a user key.
SOLANA_SERVER_KEYPAIR=
# Jupiter Swap API v2 (keyless access is rate limited; routes exist on mainnet only)
JUPITER_API_URL=https://api.jup.ag/swap/v2
JUPITER_API_KEY=

# ── Robinhood Chain (EVM, Arbitrum-based L2) ─────────────────────────────────
# mainnet (chain id 4663) | testnet (chain id 46630)
ROBINHOOD_CHAIN_NETWORK=mainnet
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Optional server-side funded private key for the EVM testnet test suite only
EVM_SERVER_PRIVATE_KEY=

# ── Robinhood Crypto Trading API (official, user-linked credentials) ─────────
# Users link their own API key + Ed25519 private key in Settings. These two are
# only needed if you want a platform-level account for admin diagnostics.
ROBINHOOD_API_BASE_URL=https://trading.robinhood.com
ROBINHOOD_PLATFORM_API_KEY=
ROBINHOOD_PLATFORM_PRIVATE_KEY_BASE64=

# ── Market data ──────────────────────────────────────────────────────────────
DEXSCREENER_API_URL=https://api.dexscreener.com

# ── Uploads ──────────────────────────────────────────────────────────────────
# local | s3   (local stores under apps/api/uploads and serves them from the API)
UPLOADS_DRIVER=local
UPLOADS_DIR=./uploads

# ── Web (public, baked into the browser bundle) ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4100
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_ROBINHOOD_CHAIN_NETWORK=mainnet
NEXT_PUBLIC_ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
