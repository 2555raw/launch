    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "ws": "^8.22.0",
    "@launch/game-core": "*"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}