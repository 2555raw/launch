# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://foundry:foundry@localhost:5432/foundry?schema=public"
# Redis (hot game state, global counters, rate limits, leaderboard)
REDIS_URL="redis://localhost:6379"
# Port the custom server listens on
PORT=3000
# Public origin, used in sign-in messages shown to wallets
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Password that elevates a logged-in account to ADMIN from /admin
ADMIN_PASSWORD="change-me"

# Solana cluster: devnet | testnet | mainnet-beta
SOLANA_CLUSTER="devnet"
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
# Launch authority keypair (the wallet that creates the mint, mints the supply and burns).
# JSON array (solana-keygen format) or base58 secret key. If unset, a keypair is generated
# and stored in .secrets/authority.json on first use (development only).
# This is the SERVER'S key. Player keys are never requested or stored.
SOLANA_AUTHORITY_SECRET=""
