# Single-container image for hosts where separate database services are not
# available (e.g. a free Railway plan): PostgreSQL and Redis run inside the
# container and keep their data on the mounted volume (DATA_DIR, default /app/data).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-15 redis-server openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --no-audit --no-fund
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build
ENV NODE_ENV=production
EXPOSE 8080
CMD ["bash", "/app/railway/start.sh"]
