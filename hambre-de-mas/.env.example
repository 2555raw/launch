# ---------------------------------------------------------------------------
# Hambre de Más · variables de entorno
# Copia este archivo a .env.local y rellénalo. NUNCA subas .env.local a git.
# Las variables NEXT_PUBLIC_* llegan al navegador: no pongas secretos en ellas.
# ---------------------------------------------------------------------------

# URL pública de la tienda (sin barra final). Se usa en emails, Stripe y SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) --------------------------------------
# Sin estas dos, la tienda arranca en MODO DEMO (catálogo de ejemplo, sin pedidos).
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: "anon" (legacy) o "publishable" (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA. Clave "service_role" (legacy) o "secret" (sb_secret_...). Solo servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers > API keys / Webhooks) ------------------------------
# SECRETA. Empieza por sk_test_ en pruebas y por sk_live_ para cobrar de verdad.
STRIPE_SECRET_KEY=
# SECRETA. Firma del endpoint de webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=

# SECRETA (opcional). Firma de los enlaces de "pago cancelado". Si falta se
# usa STRIPE_WEBHOOK_SECRET. Genera una con: openssl rand -hex 32
ORDER_TOKEN_SECRET=

# SECRETA (opcional). Protege /api/cron/expire-orders.
CRON_SECRET=

# --- Emails de confirmación (opcional, https://resend.com) ------------------
RESEND_API_KEY=
EMAIL_FROM="Hambre de Más <pedidos@tudominio.es>"

# --- Datos legales de la empresa (aparecen en aviso legal, privacidad...) ---
# Mientras estén vacíos, las páginas legales muestran [PENDIENTE: ...].
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_TAX_ID=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_REGISTRY=
NEXT_PUBLIC_SUPPORT_HOURS="De lunes a viernes, de 9:00 a 18:00"

# --- Reglas comerciales (opcional, en céntimos) ------------------------------
NEXT_PUBLIC_SHIPPING_CENTS=495
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_CENTS=4000
# IVA de los gastos de envío en puntos básicos (2100 = 21 %). Revísalo con tu asesoría.
SHIPPING_TAX_RATE_BPS=2100

# --- Analítica (opcional, solo se carga tras aceptar cookies) ---------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Redes sociales (opcional) -----------------------------------------------
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=

# --- SOLO PRUEBAS AUTOMÁTICAS ------------------------------------------------
# Apunta Stripe a tests/support/fake-stripe.mjs. Se ignora con claves sk_live_.
# STRIPE_API_BASE_URL=http://localhost:12111
