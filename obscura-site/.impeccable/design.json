      "css": ".ds-field{font-family:var(--sans,\"Host Grotesk\",system-ui,sans-serif);display:grid;gap:7px;max-width:320px}.ds-field span{font-size:14px;font-weight:500;color:var(--ink-2,#2b303a)}.ds-input{font-family:var(--sans,\"Host Grotesk\",system-ui,sans-serif);min-height:46px;padding:11px 14px;border:0;border-radius:14px;background:var(--paper,#fff);color:var(--ink,#0d1016);font-size:15px;box-shadow:inset 0 0 0 1px var(--line-2,#d5d2ca);transition:box-shadow .2s}.ds-input:hover{box-shadow:inset 0 0 0 1px var(--dim-2,#6b717c)}.ds-input:focus{outline:0;box-shadow:inset 0 0 0 1.5px var(--accent,#2458e8),0 0 0 4px var(--accent-soft,#edf2ff)}"
