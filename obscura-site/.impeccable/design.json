      "css": ".ds-night{background:#090b10;padding:28px;border-radius:20px;display:flex;gap:10px;flex-wrap:wrap}.ds-btn-white{font-family:var(--sans,\"Host Grotesk\",system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 22px;border:0;border-radius:999px;font-weight:560;font-size:15px;letter-spacing:-.005em;cursor:pointer;transition:transform .3s cubic-bezier(.22,1,.36,1),box-shadow .3s cubic-bezier(.16,1,.3,1),background-color .2s;background:#fff;color:#0b0e14;box-shadow:0 10px 30px -12px rgba(255,255,255,.35)}.ds-btn-white:hover{background:#e9edf4;transform:translateY(-1px)}.ds-btn-outline{font-family:var(--sans,\"Host Grotesk\",system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 22px;border:0;border-radius:999px;font-weight:560;font-size:15px;letter-spacing:-.005em;cursor:pointer;transition:transform .3s cubic-bezier(.22,1,.36,1),box-shadow .3s cubic-bezier(.16,1,.3,1),background-color .2s;background:transparent;color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.22)}.ds-btn-outline:hover{box-shadow:inset 0 0 0 1px rgba(255,255,255,.6);transform:translateY(-1px)}.ds-btn-white:active,.ds-btn-outline:active{transform:scale(.97)}.ds-btn-white:focus-visible,.ds-btn-outline:focus-visible{outline:2px solid var(--accent,#2458e8);outline-offset:3px;}"
