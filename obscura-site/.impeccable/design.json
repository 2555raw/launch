      "html": "<button class=\"ds-btn-dark\">Launch app</button>",
      "css": ".ds-btn-dark{font-family:var(--sans,\"Host Grotesk\",system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 22px;border:0;border-radius:999px;font-weight:560;font-size:15px;letter-spacing:-.005em;cursor:pointer;transition:transform .3s cubic-bezier(.22,1,.36,1),box-shadow .3s cubic-bezier(.16,1,.3,1),background-color .2s;background:var(--ink,#0d1016);color:var(--on-ink,#fff);box-shadow:0 1px 2px rgba(11,13,18,.05),0 6px 14px -8px rgba(11,13,18,.14)}.ds-btn-dark:hover{background:var(--ink-hover,#1f232b);transform:translateY(-1px);box-shadow:0 14px 28px -14px rgba(11,13,18,.55)}.ds-btn-dark:active{transform:scale(.97)}.ds-btn-dark:focus-visible{outline:2px solid var(--accent,#2458e8);outline-offset:3px;}"
