    {
      "name": "FAQ on Night",
      "kind": "custom",
      "refersTo": "faq",
      "description": "Numbered rows with mono hex indices and a circular plus/minus toggle.",
      "html": "<div class=\"ds-night\"><div class=\"ds-faq\"><details open><summary><span class=\"ds-n\">0x01</span><span class=\"ds-q\">Does HeldAt ever hold my funds or keys?</span><span class=\"ds-t\"></span></summary><p>No. There is no server in the loop.</p></details><details><summary><span class=\"ds-n\">0x02</span><span class=\"ds-q\">What happens if I lose a receipt?</span><span class=\"ds-t\"></span></summary><p>That bond can no longer be opened.</p></details></div></div>",
      "css": ".ds-night{background:#090b10;padding:28px;border-radius:20px;}.ds-faq{font-family:var(--sans,\"Host Grotesk\",system-ui,sans-serif);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:0 22px;background:rgba(255,255,255,.02)}.ds-faq details{border-bottom:1px solid rgba(255,255,255,.1)}.ds-faq details:last-child{border-bottom:0}.ds-faq summary{display:grid;grid-template-columns:52px 1fr 28px;align-items:center;gap:14px;padding:22px 0;cursor:pointer;list-style:none;font-size:18px;font-weight:560;letter-spacing:-.012em;color:#fff}.ds-faq summary::-webkit-details-marker{display:none}.ds-n{font-family:var(--mono,\"JetBrains Mono\",ui-monospace,monospace);font-size:13px;font-weight:400;color:#7c8596}.ds-t{position:relative;width:28px;height:28px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(127,135,150,.5)}.ds-t::before,.ds-t::after{content:\"\";position:absolute;left:50%;top:50%;width:10px;height:1.6px;margin:-.8px 0 0 -5px;background:currentColor;transition:transform .3s cubic-bezier(.16,1,.3,1)}.ds-t::after{transform:rotate(90deg)}.ds-faq details[open] .ds-t::after{transform:rotate(0)}.ds-faq p{padding:0 0 24px 66px;color:#aab3c2}.ds-faq summary:focus-visible{outline:2px solid var(--accent,#2458e8);outline-offset:3px;}"
    },
    {
      "name": "Verdicts and Caution Banner",
      "kind": "custom",
      "refersTo": "verdict-true",
      "description": "Green only for a true proof, red for false, amber for not proven or backup.",
      "html": "<div class=\"ds-v ds-true\"><span class=\"ds-bit\">1</span>Proof holds</div><div class=\"ds-v ds-false\"><span class=\"ds-bit\">0</span>Proof does not hold</div><div class=\"ds-banner\">Back up your receipts. Lost receipts cannot be recovered.</div>",
      "css": ".ds-v{font-family:var(--sans,\"Host Grotesk\",system-ui,sans-serif);display:flex;align-items:center;gap:16px;padding:18px 20px;border-radius:20px;font-weight:600;font-size:17px;margin-bottom:10px}.ds-bit{font-family:var(--mono,\"JetBrains Mono\",ui-monospace,monospace);font-size:30px;font-weight:600;line-height:1}.ds-true{background:var(--ok-soft,#e8f6ee);color:var(--ok,#0f8a43)}.ds-false{background:var(--bad-soft,#fdeeee);color:var(--bad,#c62f2f)}.ds-banner{font-family:var(--sans,\"Host Grotesk\",system-ui,sans-serif);padding:14px 16px 14px 18px;border-radius:20px;background:var(--warn-soft,#fff7e6);box-shadow:inset 0 0 0 1px var(--warn-line,#f3d9a6);color:var(--warn-ink,#4d3200);font-size:14.5px}"
