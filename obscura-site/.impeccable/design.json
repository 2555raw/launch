      "css": ".ds-fact{font-family:var(--sans,\"Host Grotesk\",system-ui,sans-serif);max-width:260px;padding:28px 26px 26px;border-radius:20px;background:var(--paper,#fff);border:1px solid var(--line,#e5e2db);color:var(--ink,#0d1016)}.ds-fact b{display:block;font-size:3rem;font-weight:650;letter-spacing:-.045em;line-height:1;font-variant-numeric:tabular-nums}.ds-fact span{display:block;margin-top:14px;color:var(--dim,#555b66);font-size:15px;max-width:22ch}"
