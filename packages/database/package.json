{
  "name": "@launch/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/prisma.mjs generate",
    "migrate:dev": "node scripts/prisma.mjs migrate dev",
    "migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "reset": "node scripts/prisma.mjs migrate reset --force",
    "seed": "node scripts/prisma.mjs db seed",
    "studio": "node scripts/prisma.mjs studio"
  },
  "dependencies": {
    "@launch/config": "*",
    "@launch/game-engine": "*",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "@types/node": "^22.20.5"
  }
}