# --- Core -------------------------------------------------------------------
# Public origin of the app; used for absolute links (checkout return, emails).
APP_URL=http://localhost:3000
# SQLite file for development. Point at a persistent volume in production.
DATABASE_URL=./data/payence.db
# 32+ random bytes, base64. Used to derive keys for encrypting TOTP secrets.
APP_SECRET=change-me-to-32-random-bytes-base64
# "development" | "production"; production refuses to start with default secrets.
NODE_ENV=development

# --- Blockchain -------------------------------------------------------------
# simulated | evm
CHAIN_PROVIDER=simulated
# For CHAIN_PROVIDER=evm (testnet by default: Base Sepolia)
CHAIN_NETWORK=base-sepolia
CHAIN_RPC_URL=https://sepolia.base.org
# xpub-style derivation: a BIP-39 mnemonic used ONLY to derive deposit addresses.
# In production this belongs in an HSM/KMS or a custody provider (Fireblocks, Coinbase Prime, Turnkey).
DEPOSIT_MNEMONIC=
# Hot wallet that signs withdrawals. Keep the balance small; sweep to cold storage.
HOT_WALLET_PRIVATE_KEY=

# --- Exchange rates ---------------------------------------------------------
# fixed | frankfurter (ECB rates via api.frankfurter.app, no key)
RATE_PROVIDER=fixed

# --- Compliance -------------------------------------------------------------
# basic (internal limits + manual review) | <vendor adapter>
COMPLIANCE_PROVIDER=basic

# --- Notifications ----------------------------------------------------------
# console | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Payence <no-reply@payence.site>
