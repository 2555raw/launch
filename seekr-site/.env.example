# ---- server ----
PORT=8080
PUBLIC_URL=https://your-domain.example        # used for share links
DATA_DIR=./data                                # JSON store + generated assets (mount a volume on Railway)
DEMO_MODE=auto                                 # auto: demo for providers without a key · on · off (no key = 503)
WELCOME_CREDITS=1000                           # credits a new account starts with (defaults to 0 when DEMO_MODE=off)
PRICE_MARKUP=1.055                             # list price = provider price × this

# ---- model providers (set the ones you have; the rest run in demo mode) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# MODEL_UPSTREAM_OVERRIDES={"gpt-6-sol":"gpt-6"}   # rename an upstream id without touching the catalog

# ---- $SEEKR on Robinhood Chain (chain id 4663) ----
ROBINHOOD_RPC_URL=
SEEKR_TOKEN_ADDRESS=
SEEKR_TOTAL_SUPPLY=1000000000
SEEKR_DECIMALS=18
SEEKR_DEXSCREENER_PAIR=                         # e.g. robinhood/0xPAIR — live price in the nav pill
SEEKR_BUY_URL=
SEEKR_CHART_URL=

# ---- deposits (leave empty and the account page offers the demo top-up instead) ----
TREASURY_ETH_ADDRESS=                          # receives ETH and USDT (ERC-20) on Ethereum mainnet
TREASURY_SOL_ADDRESS=
TREASURY_BTC_ADDRESS=
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
SOL_RPC_URL=https://api.mainnet-beta.solana.com
BTC_API_URL=https://mempool.space/api
MIN_CONFIRMATIONS=1

# ---- links ----
LINK_X=https://x.com/heySeekr
LINK_TELEGRAM=https://t.me/seekr
CONTACT_EMAIL=seek@seekr.website

# ---- email sign-in codes (optional; without it the Email code tab says so) ----
RESEND_API_KEY=
EMAIL_FROM=seekr <login@your-domain.com>

# ---- swaps (LI.FI; works without a key, the key raises rate limits) ----
LIFI_API_KEY=
SWAP_FEE=                                      # optional integrator fee, e.g. 0.0025 (set up an integrator with LI.FI first)
SWAP_INTEGRATOR=seekr
