# ─────────────────────────────────────────────────────────────────────────────
# Stepit environment. Copy to .env.local and fill in.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for metadata / Open Graph).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Network rewards are paid on. 84532 = Base Sepolia (testnet, default), 8453 = Base,
# 1 = Ethereum, 42161 = Arbitrum, 10 = Optimism, 137 = Polygon, 11155111 = Sepolia.
NEXT_PUBLIC_CHAIN_ID=84532

# Reown (WalletConnect) project id — https://cloud.reown.com. Enables mobile wallets
# and QR connections. Without it only browser-extension wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Demo mode: labels demo data and lets admins "simulate" a payout without a transfer.
# Set to false before handling real funds.
NEXT_PUBLIC_DEMO_MODE=true

# Contact addresses shown on /contact.
NEXT_PUBLIC_CONTACT_EMAIL=hello@stepit.example
NEXT_PUBLIC_SECURITY_EMAIL=security@stepit.example

# ── Server only ──────────────────────────────────────────────────────────────

# Postgres connection string. For Supabase use the pooled connection string
# (Project Settings → Database → Connection string → "Transaction pooler", port 6543).
# Leave empty to use the embedded PGlite database in PGLITE_DATA_DIR (local demo).
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
# Run pending migrations automatically on first connection (always on for PGlite).
DB_AUTO_MIGRATE=true

# Signs the session cookie. Required in production, 32+ random characters:
#   openssl rand -base64 48
SESSION_SECRET=

# Comma-separated wallet addresses allowed into /admin.
ADMIN_WALLETS=0xYourAdminWallet

# Comma-separated wallets allowed to SEND payouts (the treasury / hot wallet the admin
# connects when paying). Defaults to ADMIN_WALLETS. The server rejects any payout
# transaction that does not come from one of these.
PAYOUT_WALLETS=

# RPC endpoint for the payout network, used server-side to verify signatures from
# smart-contract wallets and to confirm payout transactions. Defaults to the chain's
# public RPC; use a dedicated provider (Alchemy, Infura, QuickNode…) in production.
RPC_URL=

# Shared secret for signed step ingestion (/api/steps/ingest) from the companion
# app backend or fitness connectors. Leave empty to disable the endpoint.
#   openssl rand -hex 32
STEP_INGEST_SECRET=
