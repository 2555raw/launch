{
	# no admin API is needed inside Railway's environment
	admin off
	# the filesystem is not persistent, so there is nothing to persist
	persist_config off
	# Railway terminates TLS at its edge; leaving this on breaks the deploy
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

# Railway assigns $PORT at runtime. The fallback is 8080 because that is the
# port the service's domains already target, so this works whether or not the
# variable is set.
:{$PORT:8080} {
	log {
		format json
	}

	root * /srv
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# The whole site is one HTML file that gets redeployed often. Without this
	# the browser keeps serving the copy it already has and a deploy looks like
	# it did nothing. no-cache still lets it revalidate, so it is cheap.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# The deployment registry polls this. Answering it from the environment is
	# what makes announcing an address a variable change rather than a deploy:
	# set TOKEN_CA in Railway and the registry fills in on the next request.
	#
	# `announced` is always true because the page needs BOTH announced and a
	# non-empty address before it will show anything, so an unset TOKEN_CA
	# leaves the registry reading "not deployed" on its own.
	handle /api/token {
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond `{"announced":true,"symbol":"{$TOKEN_SYMBOL:}","chain":"{$TOKEN_CHAIN:}","address":"{$TOKEN_CA:}","explorer":"{$TOKEN_EXPLORER:}"}`
	}

	# anything else under /api has no backend behind it, and without this it
	# would fall through to try_files and cost a 226 KB index.html per request
	handle /api/* {
		respond 404
	}

	handle {
		file_server
		# one page with hash routing, so anything unknown is still index.html
		try_files {path} /index.html
	}
}
